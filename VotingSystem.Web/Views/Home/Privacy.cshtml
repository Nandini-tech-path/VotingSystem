@{
    ViewData["Title"] = "Privacy Policy";
    Layout = "_Layout";
}
<div class="row justify-content-center py-5">
    <div class="col-lg-9">
        <div class="card-modern p-5">
            <h1 class="mb-3">@ViewData["Title"]</h1>
            <p class="text-muted mb-4">We respect your privacy and handle voter data with care. This page describes how information is collected and protected.</p>
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="feature-card p-4 h-100">
                        <h5>Data Protection</h5>
                        <p class="text-muted mb-0">Personal voter information is stored securely and used only for election participation.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="feature-card p-4 h-100">
                        <h5>Secure Sessions</h5>
                        <p class="text-muted mb-0">Authentication and session handling follow best practices to keep accounts safe.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="feature-card p-4 h-100">
                        <h5>No Data Sharing</h5>
                        <p class="text-muted mb-0">We do not sell or share voting records with unauthorized third parties.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="feature-card p-4 h-100">
                        <h5>Audit Transparency</h5>
                        <p class="text-muted mb-0">Election results can be reviewed by authorized administrators for accountability.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

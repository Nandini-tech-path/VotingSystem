@model IEnumerable<VotingSystem.Web.Models.Voter>
@{
    ViewData["Title"] = "Voters";
    Layout = "_Layout.Admin";
}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="mb-1">Voter Management</h2>
        <p class="text-muted mb-0">View and manage registered voter accounts.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <input id="voterSearch" type="search" class="form-control input-search" placeholder="Search voters..." />
    </div>
</div>

<div class="table-modern p-3">
    <table class="table table-hover mb-0" id="voterTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Email</th>
                <th>Status</th>
                <th class="text-end">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var voter in Model)
            {
                <tr>
                    <td class="text-muted">@voter.Id</td>
                    <td>@voter.Name</td>
                    <td>@voter.Email</td>
                    <td>
                        @if (voter.Status == "Active")
                        {
                            <span class="badge-status badge-success">Active</span>
                        }
                        else
                        {
                            <span class="badge-status badge-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-end">
                        <form asp-action="ToggleVoterStatus" asp-route-id="@voter.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            @if (voter.Status == "Active")
                            {
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Deactivate this voter?');">
                                    <i class="bi bi-person-x me-1"></i>Deactivate
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-success" onclick="return confirm('Reactivate this voter?');">
                                    <i class="bi bi-person-check me-1"></i>Reactivate
                                </button>
                            }
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('voterSearch');
            const tableRows = document.querySelectorAll('#voterTable tbody tr');
            if (!searchInput) return;
            searchInput.addEventListener('input', function () {
                const term = this.value.toLowerCase();
                tableRows.forEach(row => {
                    row.style.display = row.textContent.toLowerCase().includes(term) ? '' : 'none';
                });
            });
        });
    </script>
}

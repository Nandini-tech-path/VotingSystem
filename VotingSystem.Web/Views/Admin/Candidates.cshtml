@model IEnumerable<VotingSystem.Web.Models.Candidate>
@{
    ViewData["Title"] = "Candidates";
    Layout = "_Layout.Admin";
    var electionName = ViewData["ElectionName"] as string ?? "Election";
    var electionId = ViewData["ElectionId"] as int? ?? 0;
}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="mb-1">Candidates</h2>
        <p class="text-muted mb-0">@Model.Count() candidates for <strong>@electionName</strong>.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-secondary" asp-action="Elections"><i class="bi bi-arrow-left me-1"></i> Back to Elections</a>
        <a class="btn btn-primary" asp-action="CreateCandidate" asp-route-electionId="@electionId"><i class="bi bi-plus-lg me-1"></i> Add Candidate</a>
    </div>
</div>
<div class="candidate-grid mb-4">
    @foreach (var candidate in Model)
    {
        <div class="card-modern p-4 h-100">
            <div class="d-flex align-items-start justify-content-between mb-3">
                <div>
                    <h5 class="mb-1">@candidate.CandidateName</h5>
                    <small class="text-muted">Election: @electionName</small>
                </div>
                <span class="badge badge-primary">Candidate</span>
            </div>
            <div class="mb-3 text-muted">Role: Lead nominee</div>
            <div class="d-flex gap-2 flex-wrap">
                <a class="btn btn-sm btn-outline-secondary" asp-action="EditCandidate" asp-route-id="@candidate.CandidateId"><i class="bi bi-pencil"></i> Edit</a>
                <form asp-action="DeleteCandidate" asp-route-id="@candidate.CandidateId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this candidate?');"><i class="bi bi-trash"></i> Remove</button>
                </form>
            </div>
        </div>
    }
</div>

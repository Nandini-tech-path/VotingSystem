@{
    Layout = null;
    var userName = User.Identity?.Name ?? "Voter";
    string currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? string.Empty;
    Func<string,string> activeClass = action => currentAction.Equals(action, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Voter Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-topbar">
        <div class="brand-compact container-xl d-flex align-items-center justify-content-between">
            <div class="brand-compact">
                <div class="mark"><i class="bi bi-vote-fill"></i></div>
                <div class="title">
                    <div class="name">Voter Portal</div>
                    <div class="tag">Secure ballot access</div>
                </div>
            </div>
            <div class="topbar-actions">
                <a class="btn-ghost" asp-controller="Voter" asp-action="Index">Ballot</a>
                <a class="btn-ghost" asp-controller="Voter" asp-action="Results">Results</a>
                <a class="btn-primary-cta" asp-controller="Voter" asp-action="Logout">Logout</a>
            </div>
        </div>
    </div>

    <main class="voter-shell container-xl">
        <div class="ballot-wrap">
            @RenderBody()
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

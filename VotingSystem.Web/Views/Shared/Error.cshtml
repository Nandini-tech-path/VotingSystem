@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}
<div class="row justify-content-center py-5">
    <div class="col-lg-8">
        <div class="card-modern p-5 text-center">
            <div class="mb-4">
                <span class="display-5 text-danger"><i class="bi bi-exclamation-octagon-fill"></i></span>
            </div>
            <h1 class="mb-3 text-danger">Something went wrong</h1>
            <p class="text-muted mb-4">An error occurred while processing your request. Please try again or return to the home page.</p>
            @if (Model.ShowRequestId)
            {
                <p>
                    <strong>Request ID:</strong> <code class="text-danger">@Model.RequestId</code>
                </p>
            }

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger mt-4 text-start" style="max-width: 800px; margin: 0 auto; overflow: auto;">
                    <h5 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Developer Diagnostic Details</h5>
                    <p><strong>Error Message:</strong> @ViewBag.ErrorMessage</p>
                    <hr />
                    <pre style="font-size: 0.75rem;"><code>@ViewBag.StackTrace</code></pre>
                </div>
            }
            <a class="btn btn-primary mt-3" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i> Go to Home</a>
        </div>
    </div>
</div>

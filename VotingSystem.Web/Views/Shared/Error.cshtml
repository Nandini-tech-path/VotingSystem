@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}
<div class="row justify-content-center py-5">
    <div class="col-lg-8">
        <div class="card-modern p-5 text-center">
            <div class="mb-4">
                <span class="display-5 text-danger"><i class="bi bi-exclamation-octagon-fill"></i></span>
            </div>
            <h1 class="mb-3 text-danger">Something went wrong</h1>
            <p class="text-muted mb-4">An error occurred while processing your request. Please try again or return to the home page.</p>
            @if (Model.ShowRequestId)
            {
                <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
            }
            <a class="btn btn-primary mt-3" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i> Go to Home</a>
        </div>
    </div>
</div>
